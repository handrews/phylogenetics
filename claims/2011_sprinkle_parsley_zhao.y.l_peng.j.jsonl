{"actKind": "emended", "audit": {"state": "unaudited"}, "id": "2011_sprinkle_parsley_zhao.y.l_peng.j:0/children/0/children/0/children/0/children/0:act", "kind": "act", "notes": "Says \"Revised diagnosis\" rather than emended.", "path": "0/children/0/children/0/children/0/children/0", "printedAttribution": "as-record", "source": "2011_sprinkle_parsley_zhao.y.l_peng.j", "subject": "balangicystis", "tree": "taxonomy"}
{"audit": {"coverageKind": "diagnoses", "state": "unaudited"}, "id": "2011_sprinkle_parsley_zhao.y.l_peng.j:0/children/0/children/0/children/0/children/0:diagnosis", "kind": "diagnosis", "notes": "Says \"Revised diagnosis\" rather than emended.", "path": "0/children/0/children/0/children/0/children/0", "printedAttribution": "as-record", "source": "2011_sprinkle_parsley_zhao.y.l_peng.j", "subject": "balangicystis", "text": "Theca small, cup-shaped to rounded conical, 23-25 small, thick,\nheavily ridged plates per side with scattered epispires, domed\nsummit with smaller plates. Three(?) lyre-shaped exothecal\nambulacra branching off summit, up to 14 thin brachioles with\nhigh cover plates extending up center of lyre; ambulacral trunks\nbiserial, slightly rugose, large erect spines protecting trunk\nfood groove. Stalk relatively long, thin, with tiny bulbous\nto slightly spiny plates; preserved distal tip slightly expanded\nand rounded.\n", "tree": "taxonomy"}
