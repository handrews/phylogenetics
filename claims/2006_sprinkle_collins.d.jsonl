{"audit": {"coverageKind": "diagnoses", "state": "unaudited"}, "id": "2006_sprinkle_collins.d:0/children/0/children/0/children/0/children/0:diagnosis", "kind": "diagnosis", "path": "0/children/0/children/0/children/0/children/0", "printedAttribution": "as-record", "source": "2006_sprinkle_collins.d", "subject": "lyracystis", "text": "Large eocrinoids with globular to rounded conical theca having\nnumerous, irregular, ridge- and epispire-bearing thecal plates;\nthree large lyre-shaped arms with biserial-to-triserial lateral\ntrunks and numerous long straight brachioles in central V; and\nvery long, thin, multiplated stalk for attach- ment with domed,\nridged, or spiny small plates.\n", "tree": "taxonomy"}
{"audit": {"coverageKind": "skeleton", "state": "unaudited"}, "axis": "children", "form": "taxon", "id": "2006_sprinkle_collins.d:0/children/0/children/0/children/0/children/0/children/0:usage", "kind": "usage", "path": "0/children/0/children/0/children/0/children/0/children/0", "printedAttribution": "as-record", "source": "2006_sprinkle_collins.d", "spelling": "radiata_sprinkle_1973", "subject": "radiata_sprinkle_1973", "tree": "taxonomy"}
