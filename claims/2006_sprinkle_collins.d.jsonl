{"actKind": "type", "audit": {"coverageKind": "types", "state": "unaudited"}, "id": "2006_sprinkle_collins.d:0/children/0/children/0/children/0/children/0/children/0:act", "kind": "act", "path": "0/children/0/children/0/children/0/children/0/children/0", "printedAttribution": "as-record", "source": "2006_sprinkle_collins.d", "subject": "radiata_sprinkle_1973", "tree": "taxonomy"}
{"audit": {"coverageKind": "diagnoses", "state": "unaudited"}, "id": "2006_sprinkle_collins.d:0/children/0/children/0/children/0/children/0/children/0:diagnosis", "kind": "diagnosis", "path": "0/children/0/children/0/children/0/children/0/children/0", "printedAttribution": "as-record", "source": "2006_sprinkle_collins.d", "subject": "radiata_sprinkle_1973", "text": "Globular to ellipsoidal theca with heavily ridged, larger\nprimary plates and smaller secondary plates, both bearing\nscattered epispires, 4–5? wide, thick basals, summit probably\ndomed with numerous small plates bearing epispires, central\nmouth, and lateral anal pyramid in wider (CD) interray; very\nlong, thin stalk with domed proximal plates in diagonal whorls\nand slightly spiny medial and distal plating; and apparently\nthree long lyre-shaped arms attached to edge of summit with up\nto 43 long, stiff brachioles in heart-shaped array between\nheavier V-shaped arm trunks.\n", "tree": "taxonomy"}
