{"actKind": "emended", "audit": {"state": "unaudited"}, "id": "1993_dzik_orłowski:0/children/0/children/0/children/0/children/0:act:1", "kind": "act", "path": "0/children/0/children/0/children/0/children/0", "printedAttribution": "as-record", "source": "1993_dzik_orłowski", "subject": "regularis_orłowski_1968", "tree": "taxonomy"}
{"audit": {"coverageKind": "diagnoses", "state": "unaudited"}, "id": "1993_dzik_orłowski:0/children/0/children/0/children/0/children/0:diagnosis", "kind": "diagnosis", "path": "0/children/0/children/0/children/0/children/0", "printedAttribution": "as-record", "source": "1993_dzik_orłowski", "subject": "regularis_orłowski_1968", "text": "\"Elongated subcylindrical theca composed of seven circles of\nplates, mostly hexagonal in shape. The flattened oral area bears\nfive ambulacral grooves, each terminating in a pair of brachiolar\nbases, and small anal pyramid. Stem strongly tapering proximally,\ncomposed there of thin colurnnals connected by fulcra marginally,\ndistally narrow, with smooth cylindrical columnals.\"\n", "tree": "taxonomy"}
